# Скопируйте в .env и поправьте при необходимости. Все значения опциональны:
# пустое значение (DEBUG=) означает значение по умолчанию.

APP_NAME=Synex
# true: цветные логи уровня debug и Swagger на /api/docs (uvicorn остаётся на info)
DEBUG=false
HOST=127.0.0.1
PORT=8000
# Веб-страницы, которым можно ходить в API и WebSocket (Origin), через запятую.
# Сам backend и клиенты без Origin (curl, PowerShell, приложение) разрешены всегда.
ALLOWED_ORIGINS=
# Dev-сервер UI (frontend, npm run dev) на http://localhost:5173 разрешён без настройки;
# false: только ALLOWED_ORIGINS
UI_DEV_SERVER=true
# Дополнительные имена хоста в заголовке Host (127.0.0.1, localhost и HOST разрешены)
ALLOWED_HOSTS=

# Rust-воркер synex_worker (CoreDocs, раздел 3)
RUST_IPC_PIPE_NAME=\\.\pipe\synex_worker
# Unix socket (Linux/macOS). Пусто: личная папка пользователя с правами 0700
# ($XDG_RUNTIME_DIR/synex, /tmp/synex-<uid>, на macOS $TMPDIR/synex)
RUST_IPC_SOCKET_PATH=
RUST_IPC_TCP_FALLBACK_PORT=9100
RUST_EXECUTABLE_PATH_WIN32=./app/core/target/release/synex_worker.exe
RUST_EXECUTABLE_PATH_UNIX=./app/core/target/release/synex_worker
RUST_IPC_REQUEST_TIMEOUT=30
RUST_IPC_CONNECT_TIMEOUT=10
RUST_WORKER_AUTORESTART=true

# SSH: сколько ждать подключения к серверу, сек
SSH_CONNECT_TIMEOUT=20
# SSH: лимит выполнения команды по умолчанию и запас ожидания ответа воркера, сек
SSH_EXEC_TIMEOUT=30
SSH_EXEC_TIMEOUT_GRACE=10
# Сколько сессий можно открыть одновременно и размер буфера вывода одной сессии, байт
SSH_MAX_SESSIONS=20
SSH_OUTPUT_BUFFER_BYTES=1048576
# Сколько команда плагина (docker, git) ждёт, пока сессия освободится, сек
SSH_SERVICE_WAIT=10

# Хранилище SSH-ключей. По умолчанию %LOCALAPPDATA%\Synex\keys.json (Windows),
# ~/Library/Application Support/Synex (macOS), ~/.local/share/synex (Linux).
# KEYSTORE_PATH=
# Мастер-ключ Fernet. По умолчанию создаётся автоматически и хранится в системном
# хранилище учётных данных (Windows Credential Manager). Задавайте только там, где
# его нет. Сгенерировать: uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# KEYSTORE_MASTER_KEY=

# Сохранённые подключения к серверам. По умолчанию connections.json рядом с keys.json;
# пароли в нём зашифрованы тем же мастер-ключом.
# CONNECTIONS_PATH=

# Плагины через запятую или * (все установленные): ssh (сессии через воркер),
# keys (хранилище ключей), monitor (метрики серверов в /ws), connections (сохранённые
# подключения), docker (контейнеры на серверах), git (репозитории на серверах), sftp
# (файлы на серверах). Зависимости плагинов включаются сами. Что загрузилось,
# показывает GET /api/plugins.
PLUGINS_ENABLED=*

# Мониторинг: период опроса сервера и отправки метрик в /ws, окно для avg/min/max,
# через сколько метрики считаются устаревшими, таймаут опроса и сколько опрашивать
# после последнего GET /api/monitor/metrics, если /ws никто не слушает (всё в секундах)
MONITOR_POLL_INTERVAL=0.5
MONITOR_PUBLISH_INTERVAL=0.5
MONITOR_WINDOW=30
MONITOR_STALE_AFTER=3
MONITOR_POLL_TIMEOUT=5
MONITOR_DEMAND_TIMEOUT=10
# Как часто обновлять диски и видеокарты сервера (df, nvidia-smi), сек
MONITOR_HARDWARE_INTERVAL=10

# Docker на серверах (плагин docker): команда docker на сервере (например
# "sudo -n docker", если пользователь не в группе docker) и лимит на одну команду, сек
DOCKER_COMMAND=docker
DOCKER_TIMEOUT=60

# Git на серверах (плагин git): лимит на одну команду git (fetch, pull), сек
GIT_TIMEOUT=120

# Файлы на серверах (плагин sftp, SFTP Rust-воркера). Лимит одной операции и долгой
# (копирование папки, удаление дерева, контрольная сумма), сек; лимит передачи файла,
# сек; сколько передача в основной сессии (если служебную открыть нельзя) ждёт, пока
# сессию освободит команда пользователя, сек
SFTP_TIMEOUT=30
SFTP_LONG_TIMEOUT=600
SFTP_TRANSFER_TIMEOUT=3600
SFTP_SESSION_WAIT=60
# Сверять SHA-256 файла после передачи (размер сверяется всегда); как часто слать
# прогресс передачи в /ws, сек; сколько завершённых передач помнить
SFTP_VERIFY=true
SFTP_PROGRESS_INTERVAL=0.25
SFTP_TRANSFER_HISTORY=100

# WebSocket /ws: тестовые метрики вместо настоящих (разработка UI без SSH-сервера)
# и период их отправки, сек
WS_FAKE_METRICS=false
WS_FAKE_METRICS_INTERVAL=0.5
